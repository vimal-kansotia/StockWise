# Environment variables for Smart Inventory and Demand Forecasting System
# Duplicate this file to .env and adjust as necessary

# App Settings
ENV=development
LOG_LEVEL=INFO
API_KEY=dev-secret-api-key-2026
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=inventory_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory_db

# Airflow Postgres Database (isolated database within same Postgres container)
AIRFLOW_DB=airflow_db
AIRFLOW_USER=airflow_user
AIRFLOW_PASSWORD=airflow_secure_pass

# Apache Spark Configuration
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_LOCAL_MASTER=local[*]
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=1

# Airflow Settings
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Forecasting & Inventory Defaults
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_SERVICE_LEVEL=0.95
FORECAST_HORIZON_SHORT=7
FORECAST_HORIZON_LONG=28
RANDOM_SEED=42

# Data Paths
DATA_DIR=data
ARTIFACTS_DIR=artifacts
